<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %msg%n%ex</pattern>
    </encoder>
  </appender>

  <logger name="com.alx4j.jab4j" level="INFO" additivity="false">
    <appender-ref ref="STDERR" />
  </logger>

  <root level="WARN">
    <appender-ref ref="STDERR" />
  </root>
</configuration>
